# Copy to .env to override defaults (all values below match the defaults).
DATABASE_URL=sqlite:///./ai_tiny_world.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORLD_DATA_DIR=../world_data
MAP_NAME=tiny_world
LOG_LEVEL=INFO
APP_NAME='AI Tiny World'

# --- LLM（真实模型；不设 OPENAI_API_KEY 时回退到内置脚本提供者） ---
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_TOOL_CHOICE: required=每次决策强制调用一个工具（默认，普通模型如 glm-5/kimi-k3/gpt-5.6-luna/hy3/mimo-v2.5-pro 用此模式）；
# auto/none=允许思考模式模型（deepseek-v4-*、qwen3.8-max）仅文本回复，此时 provider 降级为原地等待。
LLM_TOOL_CHOICE=required
LLM_MODEL=glm-5
LLM_REFLECT_MODEL=glm-5
LLM_USE_RESPONSES=false
LLM_MAX_CONCURRENT=2
WORLD_DAILY_TOKEN_BUDGET=0
