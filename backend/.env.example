# Copy to .env to override defaults (all values below match the defaults).
DATABASE_URL=sqlite:///./ai_tiny_world.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORLD_DATA_DIR=../world_data
MAP_NAME=tiny_world
LOG_LEVEL=INFO
APP_NAME=AI Tiny World

# --- LLM（真实模型；不设 OPENAI_API_KEY 时回退到内置脚本提供者） ---
LLM_PROVIDER=auto            # auto | openai | fake
OPENAI_API_KEY=              # 第三方 API 的 key（OpenAI 兼容）
OPENAI_BASE_URL=             # 第三方 API 地址，如 https://api.deepseek.com 或 https://api.moonshot.cn/v1
LLM_MODEL=gpt-4o-mini        # 改成第三方模型名，如 deepseek-chat、kimi-k2-0711-preview
LLM_REFLECT_MODEL=gpt-4o-mini
LLM_USE_RESPONSES=false      # 第三方兼容服务只支持 /chat/completions，保持 false
LLM_MAX_CONCURRENT=2
WORLD_DAILY_TOKEN_BUDGET=0   # 0 = 不限
